<Project Sdk="Microsoft.NET.Sdk">

  <!--
    対象ゲームバージョン（BSTarget）ごとの出力先・マニフェスト。
    BSTarget は Directory.Build.props で Platform (BS1.40.8 / BS1.44.1) から決まる。
  -->
  <PropertyGroup>
    <OutputPath>bin\$(BSTarget)\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(BSTarget)\$(Configuration)\</IntermediateOutputPath>
    <ManifestPath>Manifests\$(BSTarget)\manifest.json</ManifestPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- BSIPA は末尾が .manifest.json の埋め込みリソースを探すため、名前は版によらず固定する -->
    <None Remove="Manifests\**" />
    <EmbeddedResource Include="Manifests\$(BSTarget)\manifest.json" LogicalName="ChatEmoteParticles.manifest.json" />
    <None Remove="UI\settings.bsml" />
    <EmbeddedResource Include="UI\settings.bsml" />
    <None Remove="UI\Localization\en.json" />
    <EmbeddedResource Include="UI\Localization\en.json" />
    <None Remove="UI\Localization\ja.json" />
    <EmbeddedResource Include="UI\Localization\ja.json" />
    <!-- AssetBundle -->
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!--
      自前シェーダの AssetBundle。版ごとに対応する Unity で生成しリポジトリへコミットする
        1.40.8 : Unity 2022.3.33f1 (shader-project)
        1.44.1 : Unity 6000.0.40f1 (shader-project-6000)
      埋め込み名は MaterialProvider が参照する名前に固定する。
    -->
    <None Remove="Resources\**" />
    <EmbeddedResource Include="Resources\$(BSTarget)\chatemoteparticles.bundle"
                      LogicalName="ChatEmoteParticles.Resources.chatemoteparticles.bundle"
                      Condition="Exists('Resources\$(BSTarget)\chatemoteparticles.bundle')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BeatSaberModdingTools.Tasks" Version="2.0.0-beta7">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- ================= Beat Saber 本体 ================= -->
  <ItemGroup>
    <Reference Include="Main">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\Main.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Colors">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\Colors.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Zenject">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\Zenject.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Zenject-usage">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\Zenject-usage.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="HMLib">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\HMLib.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="HMUI">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\HMUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="BGLib.Polyglot">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\BGLib.Polyglot.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- ================= Unity ================= -->
  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\UnityEngine.UnityWebRequestModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.XRModule">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\UnityEngine.XRModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.SubsystemsModule">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\UnityEngine.SubsystemsModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\UnityEngine.UI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\Unity.TextMeshPro.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- ================= Libs ================= -->
  <ItemGroup>
    <Reference Include="IPA.Loader">
      <HintPath>$(BeatSaberDir)\Beat Saber_Data\Managed\IPA.Loader.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BeatSaberDir)\Libs\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(BeatSaberDir)\Libs\Newtonsoft.Json.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="ChatCore">
      <HintPath>$(BeatSaberDir)\Libs\ChatCore.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- ================= .NET Framework ================= -->
  <ItemGroup>
    <!-- Twitch Helix API への HTTP リクエスト（SPEC §15） -->
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <!-- ================= Plugins ================= -->
  <ItemGroup>
    <Reference Include="BSML">
      <HintPath>$(BeatSaberDir)\Plugins\BSML.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="SiraUtil">
      <HintPath>$(BeatSaberDir)\Plugins\SiraUtil.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="CameraUtils">
      <HintPath>$(BeatSaberDir)\Plugins\CameraUtils.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="EnhancedStreamChat">
      <HintPath>$(BeatSaberDir)\Plugins\EnhancedStreamChat.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- ================= ビルド前チェック ================= -->
  <Target Name="CEP_ValidateTarget" BeforeTargets="BeforeBuild">
    <Error Condition="'$(BSTarget)' != '1.40.8' AND '$(BSTarget)' != '1.44.1'"
           Text="Unsupported BSTarget '$(BSTarget)'. Use Platform BS1.40.8 or BS1.44.1." />
    <Error Condition="!Exists('$(ManifestPath)')"
           Text="Manifest not found: $(ManifestPath)" />

    <!-- 参照先のゲームフォルダが対象バージョンと一致するか（BeatSaberVersion.txt 例: 1.44.1_20239） -->
    <PropertyGroup>
      <_CepGameVersionFile>$(BeatSaberDir)\BeatSaberVersion.txt</_CepGameVersionFile>
      <_CepGameVersionRaw Condition="Exists('$(_CepGameVersionFile)')">$([System.IO.File]::ReadAllText('$(_CepGameVersionFile)').Trim())</_CepGameVersionRaw>
      <_CepGameVersion Condition="'$(_CepGameVersionRaw)' != ''">$([System.Text.RegularExpressions.Regex]::Replace('$(_CepGameVersionRaw)', '_.*$', ''))</_CepGameVersion>
    </PropertyGroup>
    <Error Condition="'$(_CepGameVersion)' != '' AND '$(_CepGameVersion)' != '$(BSTarget)'"
           Text="BeatSaberDir '$(BeatSaberDir)' is game version $(_CepGameVersion), but BSTarget is $(BSTarget). Point BeatSaberDir to a $(BSTarget) instance (see ChatEmoteParticles.csproj.user)." />
    <Warning Condition="'$(_CepGameVersion)' == ''"
             Text="BeatSaberVersion.txt was not found in BeatSaberDir '$(BeatSaberDir)'; the game version could not be verified." />

    <Warning Condition="!Exists('Resources\$(BSTarget)\chatemoteparticles.bundle')"
             Text="Resources\$(BSTarget)\chatemoteparticles.bundle is missing. The build will fall back to an in-game shader at runtime. Run build-bundle.ps1 -Target $(BSTarget)." />
    <Message Importance="high" Text="ChatEmoteParticles: BSTarget=$(BSTarget), BeatSaberDir=$(BeatSaberDir)" />
  </Target>

</Project>
