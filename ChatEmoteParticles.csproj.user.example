<Project ToolsVersion="Current">

  <!--
    このファイルを ChatEmoteParticles.csproj.user にリネームし、
    BeatSaberDir を自分の環境に合わせて書き換えてください。

    ※ .csproj.user は .gitignore で除外されています。

    ※ 対象ゲームバージョン（BSTarget）ごとに、そのバージョンのインスタンスを指定すること。
      BSTarget は Platform（BS1.40.8 / BS1.44.1）で切り替わります。
      ビルド前に BeatSaberDir\BeatSaberVersion.txt と照合し、一致しない場合はエラーになります。
      ビルドしないバージョンの BeatSaberDir は未設定のままで構いません。
  -->
  <PropertyGroup Condition="'$(BSTarget)' == '1.40.8'">
    <BeatSaberDir>C:\Program Files (x86)\Steam\steamapps\common\Beat Saber</BeatSaberDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(BSTarget)' == '1.44.1'">
    <BeatSaberDir>C:\Program Files (x86)\Steam\steamapps\common\Beat Saber</BeatSaberDir>
  </PropertyGroup>

</Project>
